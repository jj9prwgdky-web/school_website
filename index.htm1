<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Nkwatia Presbyterian Senior High School</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f8f5;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #075c36;
      color: white;
      padding: 22px 15px;
      text-align: center;
    }

    header h1 {
      font-size: 25px;
    }

    nav {
      background: #064528;
      padding: 14px 8px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 5px 8px;
      font-size: 13px;
      font-weight: bold;
      display: inline-block;
    }

    .hero {
      min-height: 420px;
      background:
        linear-gradient(rgba(0,40,20,.65), rgba(0,40,20,.65)),
        url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1400&q=80");
      background-size: cover;
      background-position: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: white;
      padding: 30px 20px;
    }

    .hero h2 {
      font-size: 36px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 17px;
      max-width: 600px;
      margin-bottom: 25px;
    }

    .button {
      display: inline-block;
      background: #f4c542;
      color: #173b26;
      padding: 12px 24px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
    }

    section {
      padding: 45px 20px;
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      color: #075c36;
      font-size: 28px;
      margin-bottom: 25px;
    }

    .about {
      text-align: center;
    }

    .about p {
      max-width: 750px;
      margin: auto;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,.07);
      text-align: center;
    }

    .card h3 {
      color: #075c36;
      margin-bottom: 10px;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 15px;
    }

    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 10px;
    }

    .contact {
      background: #e5f0e8;
      border-radius: 12px;
      text-align: center;
      padding: 30px 15px;
    }

    footer {
      background: #064528;
      color: white;
      text-align: center;
      padding: 22px 15px;
      font-size: 14px;
    }

    @media (max-width: 480px) {
      header h1 {
        font-size: 21px;
      }

      .hero h2 {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>NKWATIA PRESBY SENIOR HIGH</h1>
    <p>Knowledge • Discipline • Excellence</p>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#academics">Academics</a>
    <a href="#gallery">Gallery</a>
    <a href="#contact">Contact</a>
  </nav>

  <div class="hero" id="home">
    <h2>Welcome to Our School</h2>
    <p>
      Building bright futures through quality education,
      discipline, leadership and excellence.
    </p>
    <a href="#about" class="button">Discover Our School</a>
  </div>

  <section class="about" id="about">
    <h2 class="section-title">About Our School</h2>
    <p>
      Welcome to Nkwatia Presbyterian Senior High School.
      We are committed to education, character development,
      responsible leadership and preparing students for a
      successful future. Our goal is to create an environment
      where every student can learn, grow and achieve their potential.
    </p>
  </section>

  <section id="academics">
    <h2 class="section-title">Explore Our School</h2>

    <div class="cards">
      <div class="card">
        <h3>📚 Academics</h3>
        <p>Encouraging learning, creativity and academic achievement.</p>
      </div>

      <div class="card">
        <h3>🏆 Achievements</h3>
        <p>Celebrating student progress, talents and accomplishments.</p>
      </div>

      <div class="card">
        <h3>🤝 Student Life</h3>
        <p>Promoting teamwork, friendship, leadership and discipline.</p>
      </div>
    </div>
  </section>

  <section id="gallery">
    <h2 class="section-title">School Gallery</h2>

    <div class="gallery">
      <img
        src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=800&q=80"
        alt="School building">

      <img
        src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=800&q=80"
        alt="Students learning">

      <img
        src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=800&q=80"
        alt="Students celebrating education">
    </div>
  </section>

  <section id="contact">
    <div class="contact">
      <h2 class="section-title">Contact Our School</h2>
      <p>For official enquiries, please contact the school administration.</p>
      <p><strong>School:</strong> Nkwatia Presbyterian Senior High School</p>
      <p><strong>Location:</strong> Nkwatia, Ghana</p>
    </div>
  </section>

  <footer>
    <p>&copy; 2026 Nkwatia Presbyterian Senior High School.</p>
    <p>Designed with pride 💚</p>
  </footer>

</body>
</html>
